# Uses PostGIS base (Postgres 16 + PostGIS 3.4, Debian bullseye)
FROM postgis/postgis:16-3.4

# Installs pgRouting.
# bullseye-pgdg is EOL and was moved to apt-archive.postgresql.org (removed from apt.postgresql.org end of Sept 2026).
# GDAL/ogr2ogr is not needed here: imports run in the loader image.
RUN sed -i 's|http://apt.postgresql.org/pub/repos/apt|https://apt-archive.postgresql.org/pub/repos/apt|' \
        /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        postgresql-16-pgrouting \
    && rm -rf /var/lib/apt/lists/*

RUN echo "PostGIS + pgRouting installed"
