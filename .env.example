# --- POSTGRES DATABASE ---
POSTGRES_DB=nevers
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Host machine port → mapped to container port 5432 (for local psql access)
PG_PORT=5433

# PG* variables: used by psql, psycopg2, libpq, and the config.py
PGHOST=db
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=nevers

# --- FLASK API VARIABLES ---
FLASK_PORT=5000
FLASK_DEBUG=True


# --- LINUX USER / GROUP ---
UID=1000
GID=1000